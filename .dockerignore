# Ignorar directorios de control de versiones
.git
.gitignore

# Ignorar archivos temporales y compilados de Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
env.bak/
venv.bak/

# Ignorar configuración local (el contenedor usará el del servidor AWS)
.env
.env.*
!.env.example

# Ignorar las carpetas de datos locales 
# (No queremos subir la base de datos de pruebas o logs locales de Windows al servidor)
db/
logs/
audit/
scratch/

# Ignorar herramientas y scripts locales
scripts/
simulador_vivo.py
launcher.py

# Ignorar caché de VSCode u otros IDEs
.vscode/
.idea/

# Documentación interna (excluida de Git por privacidad, no debe ir a la imagen pública)
docs/
GUIA_INTEGRACION.md
PLAYBOOK_NEW_API.md

# Ruido de desarrollo
.pytest_cache/
.agents/
tests/

# ─── Datos de clientes, respaldos y credenciales (v1.9.7) ───────────────────
# La imagen se publica en Docker Hub y se construye en la máquina de
# desarrollo, donde la carpeta del proyecto tiene respaldos de bases (con
# credenciales cifradas) y crudos de clientes. Nada de eso puede viajar en la
# imagen (auditoría, B-11). Los patrones con **/ cubren cualquier nivel.
**/db/
**/db_backup*
**/*respaldo*
**/tive_crudos*
**/audit/
**/logs/
**/*.jsonl
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/rc_token_cache*
**/*.pem
**/*.key
**/.env
**/.env.*
!.env.example
**/__pycache__/
pytest.ini
.claude/
